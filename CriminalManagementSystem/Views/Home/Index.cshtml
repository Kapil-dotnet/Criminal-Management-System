@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4">Criminal Management System</h1>

    <p class="lead mt-3">
        Manage and search criminal records.
    </p>

    <div class="mt-4">
        <a asp-controller="Criminals"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            View Criminals
        </a>

        <a asp-controller="Criminals"
           asp-action="Create"
           class="btn btn-outline-primary btn-lg ms-2">
            Add New Criminal
        </a>
    </div>
</div>